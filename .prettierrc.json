{
    "proseWrap": "always",
    "printWidth": 150,
    "arrowParens": "always",
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "css",
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "endOfLine": "lf",
    "tabWidth": 4,
    "useTabs": false,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
